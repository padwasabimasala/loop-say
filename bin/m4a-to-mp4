#!/usr/bin/env bash
set -euo pipefail

ffmpeg="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/ffmpeg"
[[ -x "$ffmpeg" ]] || { echo "Missing project FFmpeg: $ffmpeg" >&2; exit 1; }

"$ffmpeg" -loop 1 -i var/cover.png -i "$1" \
  -vf "drawtext=text='Bible Memory Club | Matthew 5':fontcolor=white:fontsize=48:x=(w-text_w)/2:y=h-100" \
  -metadata title="Bible Memory Club | Matthew 5" -metadata description="Media to help you memorize the word of God" \
  -c:v libx264 -tune stillimage -c:a aac -b:a 192k -shortest -pix_fmt yuv420p "${1%.*}.mp4"
