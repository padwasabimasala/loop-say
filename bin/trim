#!/usr/bin/env bash
set -euo pipefail

length=30
if [[ ${1:-} == --length ]]; then
  length=${2:-}
  shift 2
fi

[[ $# -eq 1 ]] || { echo "Usage: bin/trim [--length MINUTES] input.mp4" >&2; exit 1; }
[[ $length =~ ^[1-9][0-9]*$ ]] || { echo "Length must be a whole number of minutes" >&2; exit 1; }

input=$1
output="${input%.mp4}-trim.mp4"
seconds=$((length * 60))
fade_start=$((seconds - 3))

[[ -f "$input" ]] || { echo "Input file not found: $input" >&2; exit 1; }

ffmpeg -i "$input" -t "$seconds" -c:v copy -af "afade=t=out:st=$fade_start:d=3" -c:a aac -n "$output"
